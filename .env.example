# Copier en .env (ignoré par git). Aucun secret ne sort de ce fichier :
# ni dans la conversation, ni dans les logs, ni dans les manifestes.

# --- YouTube ---
# Clé API Data v3 (lecture publique : registre, veille). Projet Google Cloud unique.
YT_API_KEY=
# OAuth (upload, videos.update, thumbnails.set) — fichier client_secret dans secrets/
YT_OAUTH_CLIENT_SECRET_FILE=./secrets/yt_client_secret.json
YT_OAUTH_TOKEN_DIR=./secrets/yt_tokens

# --- Caches de modèles, redirigés sous models/ (plancher disque : 8 Go libres) ---
HF_HOME=./models/hf
OLLAMA_MODELS=./models/ollama
# llama.cpp (brique LLM) : poids GGUF sous models/, jamais dans ~/.cache
LLAMA_CACHE=./models/llamacpp

# --- Notifications (optionnel, laissé vide tant que non configuré) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Contact publié dans le User-Agent des API gratuites (Wikimedia, NCBI).
# Vide : Wikimedia plafonne à 10 req/min et PubMed est écarté (tool= et email= exigés).
FACTORY_CONTACT=
